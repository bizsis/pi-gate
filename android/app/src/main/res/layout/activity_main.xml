<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FB">

    <!-- ===================================================== -->
    <!-- FEJLÉC -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HAMBURGER -->
        <TextView
            android:id="@+id/btnHamburger"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#0B3768"
            android:textSize="28sp" />

        <!-- PI GATE IKON -->
        <ImageView
            android:id="@+id/imgHeaderLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:contentDescription="PI Gate"
            android:scaleType="fitCenter"
            android:src="@drawable/pi_gate" />

        <!-- PI GATE BRAND -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PI Gate"
                android:textColor="#0B3768"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobil blokkoló"
                android:textColor="#687386"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- KITÖLTŐ -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- VEVŐ CÉG NEVE -->
        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="N+T Kft."
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- FŐ TARTALOM -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- NFC KÉP -->
        <ImageView
            android:id="@+id/imgNfc"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:contentDescription="NFC kártyaolvasás"
            android:scaleType="fitCenter"
            android:src="@drawable/nfc" />

        <!-- ================================================= -->
        <!-- BLOKKOLÁSI IRÁNY BILLENŐKAPCSOLÓ -->
        <!-- ================================================= -->

        <FrameLayout
            android:id="@+id/directionToggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/toggle_track"
            android:clickable="true"
            android:focusable="true">

            <!-- BAL OLDALI FELIRAT -->
            <TextView
                android:id="@+id/tvDirectionLeft"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:paddingStart="22dp"
                android:text="ÉRKEZÉS"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- JOBB OLDALI FELIRAT -->
            <TextView
                android:id="@+id/tvDirectionRight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:paddingEnd="22dp"
                android:text="TÁVOZÁS"
                android:textColor="#687386"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- MOZGÓ KÉK ELEM -->
            <View
                android:id="@+id/directionThumb"
                android:layout_width="132dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="6dp"
                android:background="@drawable/toggle_thumb" />

            <!-- AKTÍV FELIRAT A MOZGÓ ELEMEN -->
            <TextView
                android:id="@+id/tvDirectionActive"
                android:layout_width="132dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="ÉRKEZÉS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- KAMERA ELŐNÉZET -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ALSÓ MENÜ + LÁBLÉC -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ALSÓ NAVIGÁCIÓ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Kezdőlap"
                android:textColor="#1769E0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navLog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Napló"
                android:textColor="#626D7C"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/navStatus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Állapot"
                android:textColor="#626D7C"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- LÁBLÉC -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- BAL OLDAL: LOGÓ + PAKSI INFORMATIKA -->
            <LinearLayout
                android:id="@+id/footerLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/footerLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Paksi Informatika"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <TextView
                    android:id="@+id/footerCompany"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Paksi Informatika"
                    android:textColor="#0B3768"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- KÖZÉP: WEB -->
            <LinearLayout
                android:id="@+id/footerCenter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="www.pikft.hu"
                    android:textColor="#0B3768"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- JOBB OLDAL: VERZIÓ -->
            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verzió: v1.2.146"
                android:textColor="#687386"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- HAMBURGER / ADMIN MENÜ -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/hamburgerMenu"
        android:layout_width="290dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ADMIN FEJLÉC -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PI Mobile Admin"
            android:textColor="#0B3768"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="18dp"
            android:text="PI Gate"
            android:textColor="#687386"
            android:textSize="13sp" />

        <!-- DOLGOZÓK -->
        <TextView
            android:id="@+id/menuEmployees"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Dolgozók"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- MUNKAIDŐ -->
        <TextView
            android:id="@+id/menuWorkTime"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Munkaidő"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- ESZKÖZ ÁLLAPOT -->
        <TextView
            android:id="@+id/menuDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Eszköz állapot"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- SZINKRONIZÁLÁS -->
        <TextView
            android:id="@+id/menuSync"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Szinkronizálás"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- SZERVER KAPCSOLAT -->
        <TextView
            android:id="@+id/menuServer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Szerver kapcsolat"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- WI-FI -->
        <TextView
            android:id="@+id/menuWifi"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Wi-Fi beállítás"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- ADMIN -->
        <TextView
            android:id="@+id/menuAdmin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Admin beállítások"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- KIOSK KILÉPÉS -->
        <TextView
            android:id="@+id/menuExitKiosk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Kilépés"
            android:textColor="#A83D3D"
            android:textSize="17sp" />

        <!-- NÉVJEGY -->
        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:text="Névjegy"
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- KITÖLTŐ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- MENÜ ALSÓ BRAND -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PI Gate • PI Mobile"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
